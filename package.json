{
  "name": "papier",
  "version": "0.1.0",
  "description": "Generate PDFs from HTML, React or Markdown with a Rust engine: milliseconds, no browser, no network. Create, download, preview.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeLienard/papier.git"
  },
  "bugs": {
    "url": "https://github.com/noeLienard/papier/issues"
  },
  "homepage": "https://github.com/noeLienard/papier#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components.d.ts",
        "default": "./dist/components.js"
      },
      "require": {
        "types": "./dist/components.d.cts",
        "default": "./dist/components.cjs"
      }
    },
    "./tree": {
      "import": {
        "types": "./dist/tree.d.ts",
        "default": "./dist/tree.js"
      },
      "require": {
        "types": "./dist/tree.d.cts",
        "default": "./dist/tree.cjs"
      }
    }
  },
  "bin": {
    "papier": "./dist/cli.js"
  },
  "files": [
    "dist",
    "native",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "html-to-pdf",
    "markdown",
    "napi",
    "pdf",
    "preview",
    "react",
    "rust"
  ],
  "scripts": {
    "build": "tsup",
    "check": "npm run typecheck && npm test && npm run build && npm run check:rust",
    "check:rust": "cargo fmt --manifest-path engine/Cargo.toml --all -- --check && cargo clippy --manifest-path engine/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --manifest-path engine/Cargo.toml --workspace",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:tree": "cargo test --manifest-path engine/Cargo.toml -p papier-tree --features ts && cp engine/crates/papier-tree/bindings/tree.ts src/tree.ts",
    "build:native": "node scripts/build-native.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mupdf": "^1.28.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
