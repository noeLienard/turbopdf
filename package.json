{
  "name": "turbopdf",
  "version": "0.3.0",
  "description": "HTML, React or Markdown to PDF in milliseconds. Native Rust engine: no browser, no network, byte-identical output, PDF/UA.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeLienard/turbopdf.git"
  },
  "bugs": {
    "url": "https://github.com/noeLienard/turbopdf/issues"
  },
  "homepage": "https://github.com/noeLienard/turbopdf#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components.d.ts",
        "default": "./dist/components.js"
      },
      "require": {
        "types": "./dist/components.d.cts",
        "default": "./dist/components.cjs"
      }
    },
    "./tree": {
      "import": {
        "types": "./dist/tree.d.ts",
        "default": "./dist/tree.js"
      },
      "require": {
        "types": "./dist/tree.d.cts",
        "default": "./dist/tree.cjs"
      }
    },
    "./edge": {
      "import": {
        "types": "./dist/edge.d.ts",
        "default": "./dist/edge.js"
      },
      "require": {
        "types": "./dist/edge.d.cts",
        "default": "./dist/edge.cjs"
      }
    },
    "./turbopdf.wasm": "./wasm/turbopdf.wasm"
  },
  "bin": {
    "turbopdf": "./dist/cli.js"
  },
  "files": [
    "dist",
    "native",
    "wasm/turbopdf.wasm",
    "README.md",
    "llms.txt",
    "LICENSE",
    "LICENSE-FONTS.txt",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pdf",
    "html-to-pdf",
    "react-pdf",
    "markdown-to-pdf",
    "pdf-generation",
    "puppeteer-alternative",
    "invoice",
    "qr-code",
    "pdf-ua",
    "accessibility",
    "nextjs",
    "rust",
    "napi",
    "ai",
    "llm",
    "llms-txt"
  ],
  "scripts": {
    "build": "tsup",
    "check": "npm run typecheck && npm test && npm run build && npm run check:trace && npm run check:rust",
    "check:trace": "node scripts/check-trace.mjs",
    "check:rust": "cargo fmt --manifest-path engine/Cargo.toml --all -- --check && cargo clippy --manifest-path engine/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --manifest-path engine/Cargo.toml --workspace",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:tree": "cargo test --manifest-path engine/Cargo.toml -p turbopdf-tree --features ts && cp engine/crates/turbopdf-tree/bindings/tree.ts src/tree.ts",
    "build:native": "node scripts/build-native.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:wasm": "node scripts/test-wasm.mjs",
    "bench": "tsx bench/run.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "tsx": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "tsx": {
      "optional": true
    }
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mupdf": "^1.28.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
